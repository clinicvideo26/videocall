// Prisma schema for the Clinic Pre-Consultation tool (Phase 1).
// Data model per Phase1_Build_Spec.md Section 4.
// Audio and PDF live in object storage; only their paths are stored here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of a consultation record.
enum ConsultationStatus {
  waiting
  active
  done
}

/// A single pre-consultation session (video + transcript + summary).
model Consultation {
  /// Long, random, hard-to-guess ID generated by the app (not sequential).
  id             String             @id
  /// Patient / reference name.
  name           String
  /// Daily.co room URL for this consultation.
  roomUrl        String
  createdAt      DateTime           @default(now())
  status         ConsultationStatus @default(waiting)
  /// When the patient accepted the consent screen (null until they agree).
  consentAt      DateTime?
  /// Optional consent: allow anonymised content to improve the service.
  consentImprove Boolean            @default(false)
  /// Finalised transcript text (deleted after 3 days by the retention job).
  transcript     String?
  /// Claude-generated summary (deleted after 3 days).
  summary        String?
  /// Object-storage path to the generated PDF (deleted after 3 days).
  pdfPath        String?
  /// Object-storage path to the audio recording (deleted after 1 day).
  audioPath      String?

  @@map("consultations")
}
