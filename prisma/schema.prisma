// Prisma schema for the Clinic Consultation tool.
// Data model per phase1-spec-v2.md §3 and §8.
// Section 3 pass: adds Clinic, User (roles), OTP challenges, and links a
// consultation to its owning clinic + assigned doctor. The broader Consultation
// rework (patientPhone, mode, split summary/patient-message) lands in later
// sections; existing columns are kept so nothing breaks in this pass.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Staff roles (v2 §3). Replaces the single shared clinic login from v1.
enum Role {
  admin
  reception
  doctor
}

/// A clinic tenant (v2 §8). Set up manually at onboarding.
model Clinic {
  id             String         @id @default(cuid())
  name           String
  whatsappNumber String
  createdAt      DateTime       @default(now())
  users          User[]
  patients       Patient[]
  consultations  Consultation[]

  @@map("clinics")
}

/// A patient, identified by phone within a clinic (v2 §5/§8). New number → new
/// record; an existing number surfaces past summaries.
model Patient {
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  phone     String
  name      String?
  createdAt DateTime @default(now())

  @@id([clinicId, phone])
  @@map("patients")
}

/// Staff account (v2 §3 / §8). Created by an admin — no self-registration.
/// Login is by phone + OTP; an optional short PIN allows quick re-entry on
/// shared machines.
model User {
  id            String         @id @default(cuid())
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  phone         String         @unique
  role          Role
  name          String
  /// Doctors only, optional.
  specialty     String?
  /// scrypt hash of the quick-re-entry PIN (null until the user sets one).
  pinHash       String?
  createdAt     DateTime       @default(now())
  consultations Consultation[] @relation("DoctorConsultations")

  @@map("users")
}

/// One-time login codes for phone + OTP auth (v2 §3). Stored hashed with a
/// short expiry; the newest unconsumed row per phone is the active challenge.
model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_challenges")
}

/// In-clinic (audio) vs online (video) consultation (v2 §4).
enum ConsultationMode {
  audio
  video
}

/// Lifecycle of a consultation record. v2 §8 flow is registered → in_room →
/// active → review → done; the v1 values (waiting) are kept so pre-v2 rows and
/// existing code stay valid.
enum ConsultationStatus {
  waiting
  registered
  in_room
  active
  review
  done
}

/// A single consultation session (video + transcript + summary).
model Consultation {
  /// Long, random, hard-to-guess ID generated by the app (not sequential).
  id             String             @id
  /// Patient / reference name (kept for display; patient identity is the phone).
  name           String
  /// Patient phone — the identifier within the clinic (v2 §5). Nullable so
  /// pre-v2 rows survive; reception sets it going forward.
  patientPhone   String?
  /// In-clinic audio vs online video (v2 §4).
  mode           ConsultationMode   @default(video)
  /// Daily.co room URL (video only; empty for audio consultations).
  roomUrl        String
  createdAt      DateTime           @default(now())
  status         ConsultationStatus @default(waiting)
  /// When the patient accepted the consent screen (null until they agree).
  consentAt      DateTime?
  /// Optional consent: allow anonymised content to improve the service.
  consentImprove Boolean            @default(false)
  /// Finalised transcript text.
  transcript     String?
  /// Claude-generated summary.
  summary        String?
  /// Object-storage path to the generated PDF.
  pdfPath        String?
  /// Object-storage path to the audio recording.
  audioPath      String?

  /// Owning clinic (v2 §3). Nullable so pre-v2 rows survive the migration.
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])
  /// Assigned doctor, set by reception at creation (v2 §3). Nullable for now.
  doctorId String?
  doctor   User?   @relation("DoctorConsultations", fields: [doctorId], references: [id])

  @@map("consultations")
}
