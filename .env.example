# Copy this file to .env and fill in real values. Never commit .env.
# Env vars per Phase1_Build_Spec.md Section 6. API integrations are NOT wired
# up yet (Phase 1, Step 1) — these are documented here for later steps.

# App
APP_URL=http://localhost:3000
CLINIC_LOGIN_USER=
# Generate with: node scripts/hash-password.mjs "your-password"
CLINIC_LOGIN_PASSWORD_HASH=
# Long random string used to sign the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Daily
DAILY_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=

# Claude (summary)
ANTHROPIC_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Template that sends the consultation PDF to the clinic (existing flow).
WHATSAPP_TEMPLATE_NAME=
CLINIC_WHATSAPP_NUMBER=
# Second template that sends the PATIENT their appointment. BODY takes 3 vars:
# {{1}} name, {{2}} time, {{3}} join link. The link goes in the body TEXT (no
# URL button — WhatsApp rewrites dynamic button URLs and breaks the long link).
WHATSAPP_APPOINTMENT_TEMPLATE_NAME=
# Authentication template that sends staff their login OTP (body {{1}} = code,
# with a copy-code / one-tap button). When set, login codes are sent on WhatsApp
# instead of only logged; you can then drop OTP_DEV_MODE. Unset = log only.
WHATSAPP_OTP_TEMPLATE_NAME=
# Template that sends the PATIENT their doctor-approved instructions (how to use
# medication + follow-up). BODY takes 1 variable: {{1}} the instructions text.
# Unset = the patient message isn't sent (doctor can send manually).
WHATSAPP_INSTRUCTIONS_TEMPLATE_NAME=
# Optional overrides (sensible defaults if unset):
# WHATSAPP_APPOINTMENT_TEMPLATE_LANG=en_US
# WHATSAPP_OTP_TEMPLATE_LANG=en
# WHATSAPP_DEFAULT_COUNTRY_CODE=91   # prepended to bare 10-digit patient numbers

# Database / storage
# Local Postgres example: postgresql://user:password@localhost:5432/videocall
DATABASE_URL=
STORAGE_BUCKET=
